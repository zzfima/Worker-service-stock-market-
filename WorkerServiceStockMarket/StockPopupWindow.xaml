<Window x:Class="WorkerServiceStockMarket.StockPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock Prices"
        Width="350"
        Height="200"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Background="White">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="StocksPanel">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="300" 
                            Height="70" 
                            BorderBrush="Gray" 
                            BorderThickness="1" 
                            Margin="5"
                            Background="{Binding BackgroundColor}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" 
                                       Grid.Column="0" 
                                       Text="{Binding Symbol}" 
                                       FontWeight="Bold" 
                                       FontSize="14"/>
                            
                            <TextBlock Grid.Row="0" 
                                       Grid.Column="1" 
                                       Text="{Binding Price, StringFormat='${0:F2}'}" 
                                       FontWeight="Bold" 
                                       FontSize="14"
                                       HorizontalAlignment="Right"/>
                            
                            <TextBlock Grid.Row="1" 
                                       Grid.Column="0" 
                                       Grid.ColumnSpan="2"
                                       Text="{Binding ChangeText}" 
                                       FontSize="11"
                                       Foreground="{Binding ChangeColor}"/>
                            
                            <TextBlock Grid.Row="2" 
                                       Grid.Column="0" 
                                       Grid.ColumnSpan="2"
                                       Text="{Binding LastUpdate, StringFormat='{}{0:HH:mm:ss}'}" 
                                       FontSize="9"
                                       Foreground="Gray"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Window>
