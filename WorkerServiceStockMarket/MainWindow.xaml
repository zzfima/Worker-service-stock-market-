<Window x:Class="WorkerServiceStockMarket.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Stock Market Monitor"
        Width="0"
        Height="0"
        WindowStyle="None"
        ShowInTaskbar="False"
        Visibility="Hidden">
    
    <Grid>
        <tb:TaskbarIcon x:Name="NotifyIcon"
                        IconSource="/stock-market.png"
                        ToolTipText="Stock Market Monitor"
                        Visibility="Visible">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show Stock Prices" Click="ShowPrices_Click"/>
                    <Separator/>
                    <MenuItem Header="Configure" Click="Configure_Click"/>
                    <MenuItem Header="Update Now" Click="UpdateNow_Click"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="Exit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
